<div id="slider" class="pb-6">
  <div class="w-full grid grid-cols-2 gap-x-32 gap-y-2">
    <p class="text-start text-gray-500">
      <%= pluralize_item(current_cart.items_count, "товар", "товара", "товаров") %> на сумму
    </p>
    <p class="text-end">
      <%= number_to_currency(current_cart.total, precision: 0, unit: '₽', format: '%n %u') %>
    </p>
    <p class="text-start text-gray-500 mb-2">Передвигая слайдер, укажите сумму скидки</p>
    <p id="discount_value" class="text-end text-teal-400">
      <%= number_to_currency(current_cart.discount, precision: 0, unit: '₽', format: '%n %u') %>
    </p>
  </div>
  <%= form_with url:update_discount_cart_path, method: :patch, data: { turbo: true } do |f| %>
    <input name="discount_amount" type="range" min="0"
    max="<%= [current_cart.total - 100, 1000].min %>"
    value="<%= current_cart.discount %>" step="100"
    class="w-full mt-6 h-1 bg-teal-400 rounded-lg appearance-none cursor-pointer accent-teal-400"
    oninput="clearTimeout(this.timer); this.timer = setTimeout(() => this.form.requestSubmit(), 1000)">
  <% end %>
</div>

<style>
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 30px;
    height: 30px;
    background-color: #2dd4bf;
    border-radius: 50%;
    cursor: pointer;
  }
  
  input[type="range"]::-moz-range-thumb {
    width: 30px;
    height: 30px;
    background-color: #2dd4bf;
    border-radius: 50%;
    border: none;
    cursor: pointer;
  }
</style>